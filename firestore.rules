rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'appseeapps@gmail.com';
    }
    match /leads/{id} {
      // Visitors can only create a valid message
      allow create: if request.resource.data.keys().hasOnly(['name','phone','email','service','message','page','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 120
        && request.resource.data.email is string && request.resource.data.email.size() < 160
        && request.resource.data.phone is string && request.resource.data.phone.size() < 30
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000;
      // Only the admin account can read, update or delete
      allow read, update, delete: if isAdmin();
    }
  }
}
